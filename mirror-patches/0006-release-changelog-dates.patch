+const RELEASED_AT_MARKER = /<!--\s*released-at:\s*([^\s>]+)\s*-->/;
+
+function extractReleaseNotePublishedAt(note: string | null | undefined): string | undefined {
+  const marker = note ? RELEASED_AT_MARKER.exec(note) : null;
+  if (!marker?.[1]) return undefined;
+  const parsed = Date.parse(marker[1]);
+  if (Number.isNaN(parsed)) return undefined;
+  return new Date(parsed).toISOString();
+}
